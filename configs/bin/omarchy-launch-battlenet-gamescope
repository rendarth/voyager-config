#!/bin/bash

# Launch Battle.net (and games launched from it, e.g. Overwatch) inside
# Gamescope to isolate the input path from the Wayland compositor.
#
# Why: the LAMZU 8K mouse (>1000Hz polling) breaks mouse button input in
# Overwatch running through GE-Proton/umu on Hyprland/Wayland — clicks get
# misread (e.g. as "Escape"). Running under Gamescope fixes the Wine raw-input
# handling of high-polling-rate mice.

set -euo pipefail

PREFIX="$HOME/Games/battlenet"
LAUNCHER="$PREFIX/drive_c/Program Files (x86)/Battle.net/Battle.net Launcher.exe"

if [[ ! -f $LAUNCHER ]]; then
  echo "Battle.net is not installed. Run omarchy-install-gaming-battlenet first." >&2
  exit 1
fi

# Gaming monitor (DP-1) running at 1440p / 165Hz.
WIDTH="${GSC_WIDTH:-2560}"
HEIGHT="${GSC_HEIGHT:-1440}"
REFRESH="${GSC_REFRESH:-165}"

mullvad-exclude gamescope \
  -w "$WIDTH" -h "$HEIGHT" -r "$REFRESH" \
  -f \
  --force-grab-cursor \
  -- \
  env WINEPREFIX="$PREFIX" \
      PROTONPATH=GE-Proton \
      GAMEID=umu-battlenet \
      PROTON_VERB=run \
      __NV_PRIME_RENDER_OFFLOAD=1 \
      __GLX_VENDOR_LIBRARY_NAME=nvidia \
      __VK_LAYER_NV_optimus=NVIDIA_only \
      VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json \
      DXVK_STATE_CACHE_PATH="$PREFIX/drive_c/users/steamuser/AppData/Local/dxvk" \
      umu-run "$LAUNCHER"
