{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators",
          "items": [
            "Dictation",
            "NightLight"
          ]
        },
        {
          "id": "omarchy.clock",
          "format": "dddd h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "quickshell.spotify"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "theruckh.workspaces-per-monitor"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "io.github.justspica.omaguard"
        },
        {
          "id": "zakarch.borders"
        },
        {
          "id": "jrmmhm.pocket",
          "members": "omarchy.tray, zakarch.borders"
        },
        {
          "id": "io.github.imryiuk.workspace-profiles"
        },
        {
          "id": "io.rendarth.chromarchy",
          "category": "all",
          "colorKeys": [
            "accent",
            "background",
            "cyan",
            "magenta"
          ],
          "colorMode": "matching",
          "interval": 3600,
          "keywords": "landscape",
          "maxScore": 35
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": true,
    "id": "io.github.guiestrela.glassbar"
  },
  "idle": {
    "lock": 900,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "io.github.xadacka.window-switcher"
    },
    {
      "id": "io.github.danbosscher.fullscreen-workspace"
    },
    {
      "id": "zzwong.stage"
    },
    {
      "id": "io.github.sirjul1337.lock-explorer",
      "design": "editorial",
      "unlock": "fade",
      "boot": "theme"
    },
    {
      "id": "io.github.mtolhuys.theme-manager"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.lock",
    "omarchy.image-picker"
  ],
  "cloneSourceRestores": [
    "io.github.sirjul1337.lock-explorer",
    "io.github.mtolhuys.theme-manager"
  ]
}
